{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BfB-Schenefeld/ainative/schemas/lesson.schema.json",
  "title": "Lesson front matter",
  "type": "object",
  "required": ["id", "course", "order", "title", "capture_status", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^lesson:" },
    "course": { "type": "string", "pattern": "^course:" },
    "order": { "type": "integer", "minimum": 0 },
    "title": { "type": "string" },
    "capture_status": { "enum": ["captured", "partial", "manifest_only"] },
    "verbatim": { "type": "boolean", "description": "true if body quotes provider prose directly" },
    "duration_minutes": { "type": "integer" },
    "concepts": { "type": "array", "items": { "type": "string" } },
    "objectives": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
