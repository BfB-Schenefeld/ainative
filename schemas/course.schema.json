{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BfB-Schenefeld/ainative/schemas/course.schema.json",
  "title": "Course",
  "type": "object",
  "required": ["id", "title", "provider", "sources", "lessons"],
  "properties": {
    "id": { "type": "string", "pattern": "^course:[a-z0-9-]+/[a-z0-9-]+$" },
    "title": { "type": "string" },
    "provider": { "type": "string", "pattern": "^provider:[a-z0-9-]+$" },
    "kind": { "enum": ["upgrade-path", "certification-course", "on-demand", "workshop", "unknown"] },
    "duration_minutes": { "type": "integer", "minimum": 0 },
    "language": { "type": "string" },
    "url": { "type": "string" },
    "delivery": { "enum": ["rise360", "spa", "scorm", "live", "article", "unknown"] },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^obj:[a-z0-9-]+/\\d{2}$" },
          "text": { "type": "string" },
          "concepts": { "type": "array", "items": { "type": "string" } },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "capture_status"],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 },
          "title": { "type": "string" },
          "capture_status": { "enum": ["captured", "partial", "manifest_only"] },
          "file": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "certifications": { "type": "array", "items": { "type": "string" } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
