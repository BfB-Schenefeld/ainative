{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BfB-Schenefeld/ainative/schemas/quiz-item.schema.json",
  "title": "Quiz item",
  "type": "object",
  "required": ["id", "course", "type", "stem", "answer_status", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^quiz:" },
    "course": { "type": "string", "pattern": "^course:" },
    "lesson": { "type": "string" },
    "set": { "enum": ["final", "knowledge-check", "practice", "unknown"] },
    "type": { "enum": ["single-choice", "multiple-choice", "true-false", "matching", "open"] },
    "stem": { "type": "string" },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "text"],
        "properties": {
          "key": { "type": "string" },
          "text": { "type": "string" },
          "correct": { "type": "boolean" },
          "feedback": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "answer_status": {
      "enum": ["confirmed", "inferred", "unknown"],
      "description": "confirmed = answer key captured; inferred = derived from lesson content; unknown = never guess"
    },
    "rationale": { "type": "string" },
    "concepts": { "type": "array", "items": { "type": "string" } },
    "difficulty": { "enum": ["recall", "application", "analysis"] },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
